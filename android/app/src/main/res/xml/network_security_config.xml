<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 飞牛等局域网媒体服务器通常只提供 HTTP。HTTPS 仍仅信任系统证书。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
